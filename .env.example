# Copy to .env next to docker-compose.yml and fill in. .env is git-ignored.

# --- required ---------------------------------------------------------------

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric chat IDs allowed to use the bot. This is wavo's only
# authentication: anyone who can message the bot spends your OpenAI credits and
# your CPU. An empty value is a startup failure, not "allow everyone".
# Message the bot and read the ID out of the log line it writes for you.
WAVO_ALLOWED_CHAT_IDS=

# OpenAI, or any OpenAI-compatible provider (see OPENAI_BASE_URL below).
OPENAI_API_KEY=

# Shared with plainsong; generate with `openssl rand -hex 32`.
PLAINSONG_TOKEN=

# --- usually worth setting --------------------------------------------------

# The origin that goes into the links sent to users. Defaults to
# http://127.0.0.1:40167, which is only useful if you listen on the same
# machine; on a server put the host's name or address here.
# PLAINSONG_PUBLIC_URL=http://vps.example.com:40167

# Where compose publishes plainsong's port 8080 on the host. Defaults to the
# bare port 40167 — every interface, IPv4 and IPv6, reachable from outside.
# Naming an address here binds only that family. Read by docker compose, not by
# wavo.
# PLAINSONG_PUBLISH=127.0.0.1:8080

# --- optional ---------------------------------------------------------------

# Tags of the images to run. Read by docker compose, not by wavo; pin them to a
# sha- tag to stop `docker compose pull` from moving you.
# WAVO_IMAGE_TAG=latest
# PLAINSONG_IMAGE_TAG=latest

# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini
# OPENAI_MODEL_FALLBACK=gpt-5
# PLAINSONG_MAX_UPLOAD_MB=100
# WAVO_MAX_CONCURRENT_JOBS=1
# WAVO_KEEP_JOB_FILES=false
# WAVO_EXPOSE_CLEAN=false
# WAVO_ALLOW_DELETE=false
# WAVO_MAX_TOOL_ITERATIONS=8
# WAVO_TURN_TIMEOUT_SEC=1800
# WAVO_JOB_TIMEOUT_SEC=1200
# WAVO_LLM_TIMEOUT_SEC=90
# WAVO_HISTORY_TURNS=12
# WAVO_SESSION_TTL_MIN=120
# WAVO_TOOL_OUTPUT_CHARS=2000
# WAVO_PROGRESS_INTERVAL_SEC=5
# WAVO_SHUTDOWN_GRACE_SEC=30
# RUST_LOG=wavo=info

# Passed through to demix, e.g. --cookies-from-browser firefox
# DEMIX_YT_DLP_ARGS=

# --- proxy (optional) -------------------------------------------------------

# YouTube distrusts datacenter IPs, so a download that works at home can fail on
# a VPS. Setting WAVO_ENABLE_PROXY=true sends the downloader — and nothing else;
# Telegram, OpenAI and plainsong stay direct — out through a residential proxy.
# The four below are what iproyal.com gives you on the proxy's access page (any
# other user:password HTTP proxy works the same way). While the flag is false
# they are ignored, so they can stay filled in; with it true, the host and the
# port are required and wavo refuses to start without them.
# WAVO_ENABLE_PROXY=false
# WAVO_PROXY_HOST=geo.iproyal.com
# WAVO_PROXY_PORT=12321
# WAVO_PROXY_USERNAME=
# WAVO_PROXY_PASSWORD=
